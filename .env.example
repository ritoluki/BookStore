# =============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env.production
# and fill in your actual values
# =============================================

# Environment
APP_ENV=local
APP_DEBUG=true

# Application
APP_NAME="Bookstore DATN"
APP_URL=http://localhost/Bookstore_DATN
BASE_PATH=/Bookstore_DATN

# Database Configuration
DB_HOST=localhost
DB_PORT=3308
DB_DATABASE=websach
DB_USERNAME=root
DB_PASSWORD=

# VNPay Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp

# Session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@bookstore.local
MAIL_FROM_NAME="${APP_NAME}"
